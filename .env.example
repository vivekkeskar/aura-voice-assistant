# AURA Environment Configuration

# Server Settings
HOST=0.0.0.0
PORT=8000
DEBUG=True
LOG_LEVEL=INFO

# AI & LLM Provider Settings (Gemini 2.5 Flash / 1.5 Flash default)
GEMINI_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-2.5-flash

# Speech-to-Text (STT) Settings
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Text-to-Speech (TTS) Settings
# edge-tts is used by default (keyless); optional ElevenLabs API key below
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Weather API Key (Optional; Open-Meteo is keyless default)
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Database Configuration
DATABASE_URL=sqlite+aiosqlite:///./aura.db
